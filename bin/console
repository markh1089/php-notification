#!/usr/bin/env php
<?php
// application.php

require __DIR__.'/../vendor/autoload.php';

use Mantledevelopment\PhpTest\Channel\EmailSendingService;
use Mantledevelopment\PhpTest\NotificationService;
use Symfony\Component\Console\Application;

$application = new Application();

$application->addCommand(
    new \Mantledevelopment\PhpTest\Command\SendNotificationCommand(
        new \Mantledevelopment\PhpTest\NotificationService([
            new EmailSendingService(),
        ])
    )
);

$application->run();
